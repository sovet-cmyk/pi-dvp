[Unit]
Description=DVP wireless-touch Wi-Fi hotspot
Wants=NetworkManager.service
After=NetworkManager.service
Before=display-manager.service

[Service]
Type=oneshot
ExecStartPre=/usr/bin/nmcli radio wifi on
ExecStart=/usr/bin/bash "@DVP_ROOT@/tools/touch_hotspot.sh" start
ExecStop=-/usr/bin/bash "@DVP_ROOT@/tools/touch_hotspot.sh" stop
RemainAfterExit=yes
TimeoutStartSec=30
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
